# Copy this file to .env and change the secrets before exposing the system to a network.
API_KEY=change-me-device-key
ADMIN_TOKEN=change-me-admin-token
# true = dashboard data and the Refresh button need the admin token
PROTECT_DASHBOARD=false

# MySQL database
# local Docker: DB_HOST=smartbin-db and DB_USER=root
# AWS: DB_HOST=<your RDS endpoint> and DB_USER=admin
DB_HOST=smartbin-db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-db-password
DB_NAME=smartbin
